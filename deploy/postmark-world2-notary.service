[Unit]
Description=World 2.0 notary — certified snapshot into the notary checkout, pushed off-box (snapshot_reader only)
Documentation=file:///srv/world2-lab/ops/world2-notary.sh
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=meepo
# /etc/postmark-world2-dev.env is root:root 0600 and this runs as meepo, so
# systemd (which is root) does the reading and hands the values in. The file is
# never loosened to make a lane work, and meepo never opens it.
# THIS LINE IS THE PROD RENAME: point it at a prod credential file whose
# WORLD2_DB says `world2`, and every unit here follows without another edit.
EnvironmentFile=/etc/postmark-world2-dev.env
# Exit 0 green · 1 RED (drift, or the frozen-archive refusal naming a diff —
# the finding the notary exists to produce; ALSO a certification that could not
# be pushed, which since DEC-7 is its own red: a certification that stayed on
# the box it certifies catches nothing) · 2 could not run.
ExecStart=/bin/bash /srv/world2-lab/ops/world2-notary.sh
TimeoutStartSec=1800
Nice=10

[Install]
WantedBy=multi-user.target
