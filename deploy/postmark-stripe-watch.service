[Unit]
Description=stripe-watch — resolve completed card payments to a pot and a hand, by rule
#
# ══ STAGE B. NOT INSTALLED, NOT ENABLED, INERT UNTIL ADOPTED. ═══════════════
#
# Stage A is `node tools/funding-report.mjs`: one read-only command that shows
# every payment, its rule-derived resolution, and a one-line witness command per
# payment. Stage A needs no unit, no timer and no state, and it is the default.
#
# THIS unit is the same rules with the paste removed. Adopt it when reading the
# report and pasting a line per payment becomes tedious — not before. The
# half-page runbook (what it is, where it lives, the off switch, what returns to
# manual) is deploy/DEPLOY.md § stripe-watch.
#
# ADOPT (one command, after the env file exists — see DEPLOY.md):
#   sudo systemctl enable --now postmark-stripe-watch.timer
# TURN OFF (one command, and the town is exactly as it is today):
#   sudo systemctl disable --now postmark-stripe-watch.timer
# Nothing is stranded by turning it off: its state and journal are its own, the
# ledger rows it wrote are ordinary receipts indistinguishable from hand-pasted
# ones, and Stage A keeps working on the same rules.
#
# ── WHY THIS ONE MAY WITNESS AT ALL ─────────────────────────────────────────
# usdc-watch SEES and does not witness, because on Base the chain cannot say
# which pot a payer meant and a watcher would consume a hash's one mint chance
# ahead of the patron's own paste. Neither is true here: a Stripe checkout
# session carries client_reference_id (the town's own fund page sets it — site
# main b2260e7a), and the card rail has no payer paste-path at all ("Step 2 —
# there isn't one"), so `stripe:<session_id>` is a ref only this unit can ever
# mint. The whole argument, with the quotes, is the header of
# tools/stripe-watch.mjs.
#
# UNLIKE usdc-watch AND harbor-watch, THIS UNIT WRITES. It records witnessed
# receipts through src/fund-exec.mjs — the /fund door's own recorder, the town's
# own `epoch-close.mjs --receipt`, under the ferry's flock on town.lock. There is
# no second ledger writer. It therefore needs the pen: /etc/postmark-office.env
# carries TOWN_CLONE, STAMP_KEY, TOWN_PUSH, BOT_NAME/BOT_EMAIL exactly as the
# office and the ferry read them, and the flock keeps it out of the crossing's way.
#
# A session is held for ONE FULL CROSSING (12h) before it becomes a receipt. That
# window is the point: the intake journal at /srv/postmark-stripe/stripe-intake.jsonl
# shows the operator round the typed handle and the resolution the session is
# ABOUT to get, so a mistyped handle is fixable while the ref is still unspent.
# (In Stage A there is no window because there is no timer — the operator is the
# window, and funding-report says so on every fresh row.)
#
# THE CREDENTIAL. STRIPE_KEY is a RESTRICTED, READ-ONLY Stripe key (rk_…) with
# read permission on Checkout Sessions and nothing else — it can list payments
# and can move no money. Create it at
#   Stripe Dashboard → Developers → API keys → Restricted keys → + Create
#   permissions: Checkout Sessions = Read. Everything else = None.
# It lives in /etc/postmark-stripe-watch.env, mode 600, never in either repo —
# the box convention is /etc/<unit>.env read through EnvironmentFile=, the same
# shape as /etc/postmark-office.env. Stage A's report reads the same key from the
# environment, so one file serves both stages.
#
# INSTALL (Wright's hand, after review — installing is not adopting):
#   sudo tee /etc/postmark-stripe-watch.env >/dev/null <<'EOF'
#   STRIPE_KEY=rk_live_…
#   # STRIPE_API_VERSION=      # optional; unset = the account's default version
#   EOF
#   sudo chmod 600 /etc/postmark-stripe-watch.env
#   sudo mkdir -p /srv/postmark-stripe && sudo chown meepo /srv/postmark-stripe
#   sudo cp deploy/postmark-stripe-watch.{service,timer} /etc/systemd/system/
#   sudo systemctl daemon-reload
#   # …and STOP. Do not enable the timer until Stage A is tedious.
#
# FIRST RUN, supervised: run it once with --dry-run and read the report before
# the timer is ever enabled. A dry run decides everything and records nothing.
#   sudo -u meepo systemd-run --pipe --wait \
#     -p EnvironmentFile=/etc/postmark-office.env \
#     -p EnvironmentFile=/etc/postmark-stripe-watch.env \
#     -p WorkingDirectory=/srv/postmark-office \
#     /usr/bin/node tools/stripe-watch.mjs --dry-run --json \
#       --state /srv/postmark-stripe/state.json
After=network-online.target

[Service]
Type=oneshot
User=meepo
WorkingDirectory=/srv/postmark-office
EnvironmentFile=/etc/postmark-office.env
EnvironmentFile=/etc/postmark-stripe-watch.env
ExecStart=/usr/bin/node tools/stripe-watch.mjs \
  --state /srv/postmark-stripe/state.json \
  --journal /srv/postmark-stripe/stripe-intake.jsonl \
  --out /srv/postmark-stripe/report.json
# A Stripe read that fails exits non-zero on purpose, and the cursor is left
# where it was: a silent empty report from a watcher that could not see the
# account is indistinguishable from a quiet day, and the second one is a lie.
