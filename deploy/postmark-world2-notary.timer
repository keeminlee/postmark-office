[Unit]
Description=World 2.0 notary, nightly at 03:20 UTC — paying the timer deferred at the notary's merge

[Timer]
# 03:20 UTC: after the 17:45 close has long settled and well before the 05:45
# one, so a certification never races a clearing for the same window.
OnCalendar=*-*-* 03:20:00 UTC
Persistent=true
RandomizedDelaySec=120

[Install]
WantedBy=timers.target
