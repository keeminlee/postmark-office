[Unit]
Description=World 2.0 candle — close every window past its close, and open its successor
Documentation=file:///srv/world2-lab/ops/world2-clearing.sh
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=meepo
# /etc/postmark-world2-dev.env is root:root 0600 and this runs as meepo, so
# systemd (which is root) does the reading and hands the values in. The file is
# never loosened to make a lane work, and meepo never opens it.
# THIS LINE IS THE PROD RENAME: point it at a prod credential file whose
# WORLD2_DB says `world2`, and every unit here follows without another edit.
EnvironmentFile=/etc/postmark-world2-dev.env
# Exit 0 cleared or nothing due · 1 the clearing REFUSED (a guard fired — the
# reason is in the journal and in /srv/world2-lab/state/clearing.json) · 2 the
# lane could not run at all.
ExecStart=/bin/bash /srv/world2-lab/ops/world2-clearing.sh
TimeoutStartSec=900
Nice=5

[Install]
WantedBy=multi-user.target
