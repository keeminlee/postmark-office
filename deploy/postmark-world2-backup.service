[Unit]
Description=World 2.0 durability — pg_dump + notary bundle shipped off-box, pg_basebackup + WAL kept on-box
Documentation=file:///srv/world2-lab/ops/world2-backup.sh
After=network.target postgresql.service
Wants=postgresql.service

[Service]
Type=oneshot
User=meepo
# /etc/postmark-world2-dev.env is root:root 0600 and this runs as meepo, so
# systemd (which is root) does the reading and hands the values in. The file is
# never loosened to make a lane work, and meepo never opens it.
# THIS LINE IS THE PROD RENAME: point it at a prod credential file whose
# WORLD2_DB says `world2`, and every unit here follows without another edit.
EnvironmentFile=/etc/postmark-world2-dev.env
# Exit 0 shipped, base backup taken · 1 the off-box ship failed, or the base
# backup did (the dump still shipped; see /srv/world2-lab/state/backup.json).
ExecStart=/bin/bash /srv/world2-lab/ops/world2-backup.sh
TimeoutStartSec=3600
Nice=15
IOSchedulingClass=idle

[Install]
WantedBy=multi-user.target
